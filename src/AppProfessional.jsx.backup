                marginBottom: '20px'
              }}>
                Bottom-of-funnel prospects exhibiting strong purchasing intent, assessed using BANT and I2P strategies to ensure their high qualification status.
              </p>
              
              {/* Key Features */}
              <div style={{
                display: 'flex',
                alignItems: 'center',
                gap: '8px',
                marginTop: '25px'
              }}>
                <div style={{
                  width: '12px',
                  height: '12px',
                  background: '#FFA500',
                  borderRadius: '50%',
                  animation: 'pulse 2s ease-in-out infinite 1s'
                }} />
                <span style={{
                  fontSize: '0.95rem',
                  color: isDarkMode ? '#b0b0b0' : '#666666',
                  fontWeight: '600'
                }}>
                  BANT & I2P Qualified
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Testimonials Section */}
      <section ref={testimonialsRef} style={{
        padding: '100px 20px',
        backgroundColor: isDarkMode ? 'rgba(255,255,255,0.02)' : 'rgba(0,0,0,0.02)',
        position: 'relative',
        zIndex: 1
      }}>
        <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
          <div style={{ textAlign: 'center', marginBottom: '80px' }}>
            <h2 style={{
              fontSize: 'clamp(2rem, 5vw, 3.5rem)',
              fontWeight: '800',
              marginBottom: '20px',
              color: '#FF6B6B'
            }}>
              Client Success Stories
            </h2>
            <p style={{
              fontSize: '1.3rem',
              color: isDarkMode ? '#b0b0b0' : '#666666',
              maxWidth: '600px',
              margin: '0 auto'
            }}>
              Hear what our clients have to say about working with us
            </p>
          </div>

          <div style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(auto-fit, minmax(350px, 1fr))',
            gap: '30px'
          }}>
            {testimonials.map((testimonial, index) => (
              <div
                key={index}
                style={{
                  padding: '40px',
                  backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(255,255,255,0.8)',
                  borderRadius: '24px',
                  border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                  backdropFilter: 'blur(10px)',
                  transition: 'all 0.4s ease',
                  position: 'relative'
                }}
                onMouseEnter={(e) => {
                  e.target.style.transform = 'translateY(-10px) scale(1.02)';
                  e.target.style.boxShadow = '0 25px 50px rgba(0,0,0,0.1)';
                }}
                onMouseLeave={(e) => {
                  e.target.style.transform = 'translateY(0) scale(1)';
                  e.target.style.boxShadow = 'none';
                }}
              >
                {/* Quote Icon */}
                <div style={{
                  fontSize: '3rem',
                  color: '#FF6B6B',
                  marginBottom: '20px',
                  opacity: 0.3
                }}>
                  "
                </div>
                
                <p style={{
                  fontSize: '1.1rem',
                  lineHeight: '1.8',
                  fontStyle: 'italic',
                  marginBottom: '30px',
                  color: isDarkMode ? '#b0b0b0' : '#666666'
                }}>
                  {testimonial.content}
                </p>
                
                <div style={{ display: 'flex', alignItems: 'center', gap: '15px' }}>
                  <div style={{
                    width: '50px',
                    height: '50px',
                    borderRadius: '50%',
                    background: 'linear-gradient(135deg, #FF6B6B 0%, #4ECDC4 100%)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    color: 'white',
                    fontWeight: 'bold',
                    fontSize: '1.2rem'
                  }}>
                    {testimonial.avatar}
                  </div>
                  <div>
                    <div style={{ fontWeight: '700', color: isDarkMode ? '#ffffff' : '#1a1a1a' }}>
                      {testimonial.name}
                    </div>
                    <div style={{ fontSize: '0.9rem', color: isDarkMode ? '#888888' : '#666666' }}>
                      {testimonial.position}, {testimonial.company}
                    </div>
                  </div>
                </div>
                
                {/* Rating */}
                <div style={{ display: 'flex', marginTop: '20px', gap: '5px' }}>
                  {[...Array(testimonial.rating)].map((_, i) => (
                    <span key={i} style={{ color: '#FFD700', fontSize: '1.2rem' }}>{"\u2b50"}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Contact Section */}
      <section ref={contactRef} style={{
        padding: '100px 20px',
        position: 'relative',
        zIndex: 1
      }}>
        <div style={{ maxWidth: '800px', margin: '0 auto' }}>
          <div style={{ textAlign: 'center', marginBottom: '60px' }}>
            <h2 style={{
              fontSize: 'clamp(2rem, 5vw, 3.5rem)',
              fontWeight: '800',
              marginBottom: '20px',
              color: '#FF6B6B'
            }}>
              Let's Talk
            </h2>
            <p style={{
              fontSize: '1.3rem',
              color: isDarkMode ? '#b0b0b0' : '#666666'
            }}>
              Ready to transform your B2B demand generation?
            </p>
          </div>

          {showSuccess ? (
            <div style={{
              padding: '60px',
              backgroundColor: 'rgba(78,205,196,0.1)',
              border: '2px solid #4ECDC4',
              borderRadius: '24px',
              textAlign: 'center'
            }}>
              <div style={{
                fontSize: '3rem',
                color: '#4ECDC4',
                marginBottom: '20px'
              }}>
                {"\u2713"}
              </div>
              <h3 style={{
                fontSize: '1.5rem',
                fontWeight: '700',
                color: isDarkMode ? '#ffffff' : '#1a1a1a',
                marginBottom: '10px'
              }}>
                Thank You!
              </h3>
              <p style={{ color: isDarkMode ? '#b0b0b0' : '#666666' }}>
                We'll get back to you within 24 hours.
              </p>
            </div>
          ) : (
            <form onSubmit={handleSubmit} style={{
              padding: '60px',
              backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(255,255,255,0.8)',
              borderRadius: '24px',
              border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
              backdropFilter: 'blur(10px)'
            }}>
              <div style={{ display: 'grid', gap: '25px' }}>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '25px' }}>
                  <input
                    type="text"
                    placeholder="Your Name *"
                    required
                    value={formData.name}
                    onChange={(e) => setFormData(prev => ({ ...prev, name: e.target.value }))}
                    style={{
                      padding: '18px',
                      backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                      border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                      borderRadius: '12px',
                      color: isDarkMode ? '#ffffff' : '#1a1a1a',
                      fontSize: '1rem',
                      transition: 'all 0.3s ease'
                    }}
                    onFocus={(e) => {
                      e.target.style.borderColor = '#FF6B6B';
                      e.target.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.1)';
                    }}
                    onBlur={(e) => {
                      e.target.style.borderColor = isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
                      e.target.style.boxShadow = 'none';
                    }}
                  />
                  
                  <input
                    type="email"
                    placeholder="Business Email *"
                    required
                    value={formData.email}
                    onChange={(e) => setFormData(prev => ({ ...prev, email: e.target.value }))}
                    style={{
                      padding: '18px',
                      backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                      border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                      borderRadius: '12px',
                      color: isDarkMode ? '#ffffff' : '#1a1a1a',
                      fontSize: '1rem',
                      transition: 'all 0.3s ease'
                    }}
                    onFocus={(e) => {
                      e.target.style.borderColor = '#FF6B6B';
                      e.target.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.1)';
                    }}
                    onBlur={(e) => {
                      e.target.style.borderColor = isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
                      e.target.style.boxShadow = 'none';
                    }}
                  />
                </div>
                
                <input
                  type="text"
                  placeholder="Company Name"
                  value={formData.company}
                  onChange={(e) => setFormData(prev => ({ ...prev, company: e.target.value }))}
                  style={{
                    padding: '18px',
                    backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                    border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                    borderRadius: '12px',
                    color: isDarkMode ? '#ffffff' : '#1a1a1a',
                    fontSize: '1rem',
                    transition: 'all 0.3s ease'
                  }}
                  onFocus={(e) => {
                    e.target.style.borderColor = '#FF6B6B';
                    e.target.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.1)';
                  }}
                  onBlur={(e) => {
                    e.target.style.borderColor = isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
                    e.target.style.boxShadow = 'none';
                  }}
                />
                
                <select
                  value={formData.budget}
                  onChange={(e) => setFormData(prev => ({ ...prev, budget: e.target.value }))}
                  style={{
                    padding: '18px',
                    backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                    border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                    borderRadius: '12px',
                    color: isDarkMode ? '#ffffff' : '#1a1a1a',
                    fontSize: '1rem',
                    transition: 'all 0.3s ease'
                  }}
                  onFocus={(e) => {
                    e.target.style.borderColor = '#FF6B6B';
                    e.target.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.1)';
                  }}
                  onBlur={(e) => {
                    e.target.style.borderColor = isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
                    e.target.style.boxShadow = 'none';
                  }}
                >
                  <option value="">Select Budget Range</option>
                  <option value="5k-10k">$5,000 - $10,000</option>
                  <option value="10k-25k">$10,000 - $25,000</option>
                  <option value="25k-50k">$25,000 - $50,000</option>
                  <option value="50k+">$50,000+</option>
                </select>
                
                <textarea
                  placeholder="Tell us about your goals and requirements..."
                  value={formData.message}
                  onChange={(e) => setFormData(prev => ({ ...prev, message: e.target.value }))}
                  rows={5}
                  style={{
                    padding: '18px',
                    backgroundColor: isDarkMode ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                    border: `1px solid ${isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)'}`,
                    borderRadius: '12px',
                    color: isDarkMode ? '#ffffff' : '#1a1a1a',
                    fontSize: '1rem',
                    resize: 'vertical',
                    transition: 'all 0.3s ease'
                  }}
                  onFocus={(e) => {
                    e.target.style.borderColor = '#FF6B6B';
                    e.target.style.boxShadow = '0 0 0 3px rgba(255,107,107,0.1)';
                  }}
                  onBlur={(e) => {
                    e.target.style.borderColor = isDarkMode ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
                    e.target.style.boxShadow = 'none';
                  }}
                />
                
                <button
                  type="submit"
                  disabled={isSubmitting}
                  style={{
                    background: '#FF6B6B',
                    border: 'none',
                    color: 'white',
                    padding: '20px',
                    borderRadius: '12px',
                    fontSize: '1.1rem',
                    fontWeight: '600',
                    cursor: isSubmitting ? 'not-allowed' : 'pointer',
                    transition: 'all 0.3s ease',
                    boxShadow: '0 10px 30px rgba(255,107,107,0.3)',
                    opacity: isSubmitting ? 0.7 : 1
                  }}
                  onMouseEnter={(e) => {
                    if (!isSubmitting) {
                      e.target.style.transform = 'translateY(-3px) scale(1.02)';
                      e.target.style.boxShadow = '0 15px 40px rgba(255,107,107,0.4)';
                    }
                  }}
                  onMouseLeave={(e) => {
                    e.target.style.transform = 'translateY(0) scale(1)';
                    e.target.style.boxShadow = '0 10px 30px rgba(255,107,107,0.3)';
                  }}
                >
                  {isSubmitting ? 'Sending...' : 'Send Message'}
                </button>
              </div>
            </form>
          )}
        </div>
      </section>

      {/* Footer */}
      <footer style={{
        padding: '60px 20px 30px',
        backgroundColor: isDarkMode ? '#0a0a0a' : '#1a1a1a',
        color: '#ffffff',
        position: 'relative',
        zIndex: 1
      }}>
        <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
          <div style={{
            display: 'grid',
            gridTemplateColumns: { xs: '1fr', md: '2fr 1fr 1fr 1fr' },
            gap: '40px',
            marginBottom: '40px'
          }}>
            <div>
              <h3 style={{ fontSize: '1.5rem', fontWeight: '700', marginBottom: '20px' }}>
                TrueWaveites
              </h3>
              <p style={{ lineHeight: '1.6', color: '#b0b0b0', marginBottom: '20px' }}>
                We slice through the clutter and prioritize what truly counts - Outcomes!
              </p>
              <div style={{ display: 'flex', gap: '15px' }}>
                {['LinkedIn', 'Twitter', 'Facebook'].map((social) => (
                  <div
                    key={social}
                    style={{
                      width: '40px',
                      height: '40px',
                      backgroundColor: 'rgba(255,255,255,0.1)',
                      borderRadius: '50%',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      cursor: 'pointer',
                      transition: 'all 0.3s ease'
                    }}
                    onMouseEnter={(e) => {
                      e.target.style.backgroundColor = '#FF6B6B';
                      e.target.style.transform = 'translateY(-3px)';
                    }}
                    onMouseLeave={(e) => {
                      e.target.style.backgroundColor = 'rgba(255,255,255,0.1)';
                      e.target.style.transform = 'translateY(0)';
                    }}
                  >
                    <span style={{ fontSize: '1.2rem' }}>{social[0]}</span>
                  </div>
                ))}
              </div>
            </div>
            
            <div>
              <h4 style={{ fontSize: '1.1rem', fontWeight: '600', marginBottom: '20px' }}>
                Services
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                {services.map((service, index) => (
                  <a
                    key={index}
                    href="#services"
                    style={{
                      color: '#b0b0b0',
                      textDecoration: 'none',
                      transition: 'color 0.3s ease',
                      cursor: 'pointer'
                    }}
                    onMouseEnter={(e) => e.target.style.color = '#FF6B6B'}
                    onMouseLeave={(e) => e.target.style.color = '#b0b0b0'}
                  >
                    {service.title}
                  </a>
                ))}
              </div>
            </div>
            
            <div>
              <h4 style={{ fontSize: '1.1rem', fontWeight: '600', marginBottom: '20px' }}>
                Company
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                {['About Us', 'Case Studies', 'Blog', 'Careers'].map((item) => (
                  <a
                    key={item}
                    href="#"
                    style={{
                      color: '#b0b0b0',
                      textDecoration: 'none',
                      transition: 'color 0.3s ease',
                      cursor: 'pointer'
                    }}
                    onMouseEnter={(e) => e.target.style.color = '#FF6B6B'}
                    onMouseLeave={(e) => e.target.style.color = '#b0b0b0'}
                  >
                    {item}
                  </a>
                ))}
              </div>
            </div>
            
            <div>
              <h4 style={{ fontSize: '1.1rem', fontWeight: '600', marginBottom: '20px' }}>
                Contact
              </h4>
              <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', color: '#b0b0b0' }}>
                <div>+1-225-347-5362</div>
                <div>info@truewaveites.com</div>
                <div>74 E Glenwood Ave, Smyrna, DE 19977</div>
              </div>
            </div>
          </div>
          
          <div style={{
            borderTop: '1px solid rgba(255,255,255,0.1)',
            paddingTop: '30px',
            textAlign: 'center',
            color: '#b0b0b0'
          }}>
            <p>&copy; {new Date().getFullYear()} TrueWaveites. All Rights Reserved.</p>
          </div>
        </div>
      </footer>

      {/* Floating Action Button */}
      <button
        onClick={() => scrollToSection(contactRef)}
        style={{
          position: 'fixed',
          bottom: '30px',
          right: '30px',
          width: '60px',
          height: '60px',
          background: '#FF6B6B',
          border: 'none',
          borderRadius: '50%',
          color: 'white',
          fontSize: '1.5rem',
          cursor: 'pointer',
          boxShadow: '0 10px 30px rgba(255,107,107,0.3)',
          transition: 'all 0.3s ease',
          zIndex: 999,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center'
        }}
        onMouseEnter={(e) => {
          e.target.style.transform = 'translateY(-5px) scale(1.1)';
          e.target.style.boxShadow = '0 15px 40px rgba(255,107,107,0.4)';
        }}
        onMouseLeave={(e) => {
          e.target.style.transform = 'translateY(0) scale(1)';
          e.target.style.boxShadow = '0 10px 30px rgba(255,107,107,0.3)';
        }}
      >
        {"\u2709"}
      </button>
    </div>
  );
};

export default AppProfessional;
