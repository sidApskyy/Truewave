                  width: '100%',
                  textAlign: 'left',
                  padding: '15px 20px',
                  background: 'none',
                  border: 'none',
                  color: isDarkMode ? '#ffffff' : '#1a1a1a',
                  fontSize: '1rem',
                  fontWeight: '500',
                  cursor: 'pointer',
                  transition: 'all 0.3s ease'
                }}
              >
                {item.name}
              </button>
            ))}
          </div>
        )}
      </header>

      {/* Simple Hero Section for Debugging */}
      <section className="relative min-h-screen flex items-center justify-center bg-black" ref={heroRef}>
        <div className="text-center text-white px-5 max-w-4xl mx-auto">
          <h1 className="text-4xl md:text-6xl font-black mb-6 text-white">
            TOP B2B DEMAND GENERATION COMPANY
          </h1>
          <h2 className="text-2xl md:text-4xl font-bold text-orange-400 mb-8">
            Engage-Nature-Convert!
          </h2>
          <p className="text-lg md:text-xl text-white/80">
            A demand generation company that runs on a data-driven approach and omnichannel media expertise
          </p>
        </div>
      </section>

      {/* Premium Vision & Mission Section with Advanced Animations */}
      <section className="py-24 px-5 relative z-10 bg-gradient-to-br from-orange-50/3 via-transparent to-transparent" ref={visionRef}>
        <div className="max-w-7xl mx-auto">
          {/* Section Header with Text Reveal */}
          <div 
            className="text-center mb-20 overflow-hidden"
            transition={{ duration: 1.2, ease: "power3.out" }}
            viewport={{ once: true, amount: 0.3 }}
          >
            <h2 className="text-5xl md:text-6xl lg:text-7xl font-black text-orange-500">
              {['OUR', 'VISION', '&', 'MISSION'].map((word, i) => (
                <motion.span
                  key={word}
                  className="inline-block mx-1"
                  initial={{ y: 100, opacity: 0 }}
                  whileInView={{ y: 0, opacity: 1 }}
                  transition={{ 
                    duration: 0.6, 
                    delay: i * 0.1, 
                    ease: "power3.out" 
                  }}
                  viewport={{ once: true, amount: 0.3 }}
                >
                  {word}
                </motion.span>
              ))}
            </h2>
          </motion.div>
          
          {/* Premium Card Grid */}
          <motion.div 
            className="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto"
            initial={{ opacity: 0, y: 80 }}
            whileInView={{ opacity: 1, y: 0 }}
            transition={{ duration: 1.2, delay: 0.3, ease: "power3.out" }}
            viewport={{ once: true, amount: 0.3 }}
          >
            {/* Vision Card - Premium */}
            <motion.div
              className="group p-10 bg-gradient-to-br from-white/10 via-orange-50/5 to-white/5 backdrop-blur-xl rounded-3xl border border-orange-200/20 shadow-2xl hover:shadow-3xl transition-all duration-500 cursor-pointer"
              initial={{ opacity: 0, y: 60, scale: 0.95 }}
              whileInView={{ opacity: 1, y: 0, scale: 1 }}
              transition={{ duration: 0.8, delay: 0.5, ease: "power3.out" }}
              viewport={{ once: true, amount: 0.3 }}
              whileHover={{ 
                y: -15, 
                scale: 1.03,
                boxShadow: "0 30px 60px rgba(255, 107, 107, 0.25)",
                borderColor: "rgba(255, 107, 107, 0.3)"
              }}
              style={{ willChange: 'transform' }}
            >
              {/* Premium Icon with Animation */}
              <motion.div 
                className="flex items-center mb-6"
                initial={{ opacity: 0, x: -30 }}
                whileInView={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.6, delay: 0.7, ease: "power3.out" }}
                viewport={{ once: true, amount: 0.3 }}
              >
                <motion.div 
                  className="w-14 h-14 bg-gradient-to-br from-orange-500 to-orange-400 rounded-2xl flex items-center justify-center shadow-xl group-hover:shadow-2xl transition-all duration-300"
                  whileHover={{ rotate: 360, scale: 1.1 }}
                  transition={{ duration: 0.6, ease: "power3.out" }}
                >
                  <svg className="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor"/>
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M2 17L12 22L22 17" stroke="currentColor"/>
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M2 12L12 17L22 12" stroke="currentColor"/>
                  </svg>
