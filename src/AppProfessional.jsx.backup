              >
                Empowering clients to connect with right prospects at the precise buying moment, staying ahead of competition through partnership and value.
              </motion.p>
            </motion.div>
          </motion.div>
        </div>
      </section>

      {/* Statistics Counter Section */}
      <section style={{
        padding: '80px 20px',
        position: 'relative',
        zIndex: 1,
        backgroundColor: isDarkMode ? 'rgba(255,255,255,0.02)' : 'rgba(255,107,107,0.03)'
      }}>
        <div style={{ maxWidth: '1000px', margin: '0 auto' }}>
          <div style={{
            display: 'grid',
